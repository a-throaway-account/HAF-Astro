---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero">
  <div class="grainient-bg" id="grainient"></div>

  <div class="hero-content">
    <h1 class="hustle-title">Built by Humans,<br>Powered by Hustle</h1>
    <p>We’re not another agency.  
      We’re operators, storytellers, analysts and builders  
      obsessed with one thing — real growth.</p>
    <button class="btn" onclick="document.getElementById('team').scrollIntoView({behavior:'smooth'})">Meet Our Team</button>

  </div>
</section>
<script src="https://unpkg.com/ogl@0.0.32/dist/ogl.umd.js"></script>
<script src={`${baseUrl}/about/grainient.js`} is:inline></script>
