<script>
const reveals = document.querySelectorAll(".reveal");

function onScroll(){
  const trigger = window.innerHeight * .88;

  reveals.forEach(el=>{
    const top = el.getBoundingClientRect().top;
    if(top < trigger) el.classList.add("visible");
  });
}

window.addEventListener("scroll", onScroll);
onScroll();
</script>