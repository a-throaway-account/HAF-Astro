---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="main-footer">
    <div class="footer-container">
        <div class="footer-col about-col">
            <img src={`${baseUrl}/logos/hustleandflow-logo.png`} alt="Hustle and Flow" class="footer-logo">
            <p class="footer-description">
                Not just another agency, we're a growth partner obsessed with ROI, creativity, and long-term brand value.
            </p>
            
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Quick Links</h4>
            <ul class="footer-links">
                <li><a href={`${baseUrl}/about`}>About Us</a></li>
        <li><a href={`${baseUrl}/services`}>Services</a></li>
        <li><a href={`${baseUrl}/blogs`}>Blogs</a></li>
        <li><a href={`${baseUrl}/#contact-us`}>Contact Us</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Our Services</h4>
            <ul class="footer-links">
              <li><a href={`${baseUrl}/services`}>SEO</a></li>
        <li><a href={`${baseUrl}/services`}>Meta Ads</a></li>
        <li><a href={`${baseUrl}/services`}>Google Ads</a></li>
        <li><a href={`${baseUrl}/services`}>Amazon Ads</a></li>
        <li><a href={`${baseUrl}/services`}>SEO</a></li>
        <li><a href={`${baseUrl}/services`}>Flipkart Ads</a></li>
        <li><a href={`${baseUrl}/services`}>Creative Design</a></li>

            </ul>
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Let's Talk!</h4>
            <p class="footer-address">Aravali Koral by CS Reality, <br> Plot no. - B2, Flat O4, UGF, Chattarpur, New Delhi - 110047</p>
            <div class="social-icons">
                <a href="#"><img src={`${baseUrl}/logos/socials/Mail_ru_white.svg`} alt=""></a>
                <a href="#"><img src={`${baseUrl}/logos/socials/LinkedIN_white.svg`} alt=""></a>
                <a href="#"><img src={`${baseUrl}/logos/socials/Instagram_white.svg`} alt=""></a>


            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <p>Copyright © 2025 Hustle And Flow. All Rights Reserved.</p>
    </div>
</footer>	

<script src="https://unpkg.com/lucide@latest"></script>
